\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Distribution of reasons indicated for delegating or not 10 additional hypothetical tasks to the algorithm. {\color  {blue} Item labels correspond to the following verbatim statements presented to participants (wording adapted to whether the participant had chosen to delegate or not): \textit  {DontTrust} -- ``I don't fully trust myself/the computer''; \textit  {BetterJob} -- ``I thought the computer/I could do a better job''; \textit  {HowExactly} -- ``I find it unpleasant that I don't know how exactly the computer chooses an option for me''; \textit  {MoreInfo} -- ``I would have preferred more information about how the computer makes its decisions''; \textit  {Responsibility4Choice} -- ``I didn't want/wanted to be responsible for choosing an/the option''; \textit  {Responsibility4Outcome} -- ``I didn't want to be responsible if a low payment results''; \textit  {DislikeRelyingOn} -- ``I don't like relying on myself/computers''; \textit  {Reactance2Analysis} -- ``I don't like to be analysed by an algorithm''; \textit  {PerformanceCuriosity} -- ``I wanted to see how well the computer/I can do''; \textit  {Tedious} -- ``Doing it myself would have been too tedious'' (delegators only).\color  {black}}}}{28}{figure.45}\protected@file@percent }
\newlabel{fig:reason_selection}{{4}{28}{Distribution of reasons indicated for delegating or not 10 additional hypothetical tasks to the algorithm. \inew {Item labels correspond to the following verbatim statements presented to participants (wording adapted to whether the participant had chosen to delegate or not): \textit {DontTrust} -- ``I don't fully trust myself/the computer''; \textit {BetterJob} -- ``I thought the computer/I could do a better job''; \textit {HowExactly} -- ``I find it unpleasant that I don't know how exactly the computer chooses an option for me''; \textit {MoreInfo} -- ``I would have preferred more information about how the computer makes its decisions''; \textit {Responsibility4Choice} -- ``I didn't want/wanted to be responsible for choosing an/the option''; \textit {Responsibility4Outcome} -- ``I didn't want to be responsible if a low payment results''; \textit {DislikeRelyingOn} -- ``I don't like relying on myself/computers''; \textit {Reactance2Analysis} -- ``I don't like to be analysed by an algorithm''; \textit {PerformanceCuriosity} -- ``I wanted to see how well the computer/I can do''; \textit {Tedious} -- ``Doing it myself would have been too tedious'' (delegators only).}}{figure.45}{}}
